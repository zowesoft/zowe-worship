/build/bin/
/bin/
/.task/
# Engine tree staged for packaging by `task engines:stage`; the bytes come from
# pinned releases, not the repo.
/build/engines/
# macOS packaging assets: the Taskfile and plists are tracked (the release
# workflow needs them); generated icon/asset bytes stay untracked.
/build/darwin/*
!/build/darwin/Taskfile.yml
!/build/darwin/Info.plist
!/build/darwin/Info.dev.plist
!/build/darwin/icons.icns
!/build/darwin/dmg-background.png
!/build/darwin/dmg-file-icon.png
!/build/darwin/dmg-file-icon.icns
/benchmarks/models/
/benchmarks/tools/
/benchmarks/dumps/
/benchmarks/sermon-set/
/frontend/node_modules/
/frontend/package.json.md5
/frontend/dist/*
!/frontend/dist/.gitkeep
/frontend/*.tsbuildinfo
*.exe
*.test
*.log
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
